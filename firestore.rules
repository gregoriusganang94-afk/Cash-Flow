rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints
    function isValidUserSettings(data, userId) {
      return data.keys().hasAll(['userId', 'startPeriodKey', 'cutoffDay', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'startPeriodKey', 'cutoffDay', 'createdAt', 'updatedAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.startPeriodKey is string
        && data.startPeriodKey.size() == 7
        && data.startPeriodKey.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && data.cutoffDay is int
        && data.cutoffDay >= 1
        && data.cutoffDay <= 28
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'category', 'description', 'date', 'periodKey', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'type', 'amount', 'category', 'description', 'date', 'periodKey', 'createdAt', 'updatedAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.type is string
        && data.type.size() <= 10
        && data.type in ['income', 'expense']
        && data.amount is number
        && data.amount > 0
        && data.amount <= 1000000000000
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 60
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 200
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && data.periodKey is string
        && data.periodKey.size() == 7
        && data.periodKey.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isSignedIn() && isVerified() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn()
        && isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['startPeriodKey', 'cutoffDay', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['baseOpeningBalance', 'githubRepo', 'githubBranch', 'githubFilePath', 'updatedAt'])
        );

      allow delete: if false;

      match /transactions/{transactionId} {
        allow get: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(transactionId) && isOwner(userId);
        allow list: if isSignedIn() && isVerified() && isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isSignedIn()
          && isVerified()
          && isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isSignedIn()
          && isVerified()
          && isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'category', 'description', 'date', 'periodKey', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isSignedIn()
          && isVerified()
          && isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId);
      }
    }
  }
}
